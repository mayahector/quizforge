# Copy this file to .env and adjust values for your environment.
# .env is git-ignored and never committed.

SECRET_KEY=change-me-to-a-random-secret-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to a local sqlite3 file if unset.
# Example for Postgres: postgres://user:password@localhost:5432/quizforge
DATABASE_URL=sqlite:///db.sqlite3

# Optional: POST a JSON payload to this URL whenever a learner completes a
# quiz attempt (e.g. a Slack or Discord incoming webhook). Leave blank to
# disable webhook notifications entirely.
QUIZ_COMPLETION_WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=3.0

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
